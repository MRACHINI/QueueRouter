# QueueRouter is configured in its web admin UI (https://<domain>/admin).
# This file only holds what must exist before the database opens, plus an optional one-time
# import for the very first start.

# --- Deployment (compose files) -----------------------------------------------------------

# Public hostname (Traefik router rule / Caddy certificate). DNS must point at this server.
DOMAIN=queuerouter.example.com

# Traefik only (docker-compose.yml): your existing Traefik's network, entrypoint and resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Bootstrap (always read) --------------------------------------------------------------

# Used in setup hints and in the snippets shown when you create a client.
PUBLIC_URL=https://queuerouter.example.com

# Create the first owner automatically (otherwise: one-time setup token in the container log).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=at-least-12-characters

# Only these networks may open /admin (others get 404). Empty = anyone (still needs a login).
# ADMIN_ALLOWED_IPS=10.0.0.0/8,192.168.0.0/16

# Encryption key for secrets at rest. Default: generated into /data/secret.key — back it up!
# SECRET_KEY=

# Proxies whose X-Forwarded-For is trusted (Docker networks by default).
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1/32
LOG_LEVEL=INFO

# --- Imported ONCE on the very first start (then managed in the admin UI) -----------------
# Handy for upgrades from 0.1/0.2 or unattended installs; ignored afterwards.

# ARLIAI_API_KEY=
# UPSTREAM_URL=https://api.arliai.com/v1
# MAX_CONCURRENCY=2
# Client keys: key | name:key | name:key:priority   (priority: high, normal, low)
# ACCESS_KEYS=opencode:3f9a...:high,scripts:8c1d...:low
# Tuning (defaults shown): MAX_QUEUE_WAIT_S=0 KEEPALIVE_INTERVAL_S=15 AGING_S=120
# SESSION_AWARE=true SESSION_WINDOW_S=60 FAIR_SHARE=true MAX_RETRIES=8 RETRY_BASE_DELAY_S=2
# RETRY_MAX_DELAY_S=60 UPSTREAM_CONNECT_TIMEOUT_S=15 UPSTREAM_READ_TIMEOUT_S=600 MAX_BODY_MB=20
# AUTH_FAIL_LIMIT=10 AUTH_BLOCK_S=300
