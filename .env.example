# --- Required -----------------------------------------------------------------------------

# Public hostname (Traefik router rule / Caddy certificate). DNS must point at this server.
DOMAIN=queuerouter.example.com

# Traefik only (docker-compose.yml): your existing Traefik's network, entrypoint and resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Your real ArliAI API key. Never leaves the server.
ARLIAI_API_KEY=

# Keys your apps (opencode, ...) use to call QueueRouter. Comma-separated, one per app.
# Generate one with:  openssl rand -hex 32
ACCESS_KEYS=

# --- Queue --------------------------------------------------------------------------------

# Parallel requests allowed by your ArliAI plan (Pro = 2).
MAX_CONCURRENCY=2
# Minimum gap between request starts, in ms (0 = none).
MIN_SPACING_MS=0
# Give up on a request that waited this long in the queue (0 = wait forever).
MAX_QUEUE_WAIT_S=0
# Interval of SSE keep-alive comments sent to streaming clients while they wait.
KEEPALIVE_INTERVAL_S=15

# --- Upstream safety net ------------------------------------------------------------------

UPSTREAM_URL=https://api.arliai.com/v1
# Retries on 429/5xx/connection errors (-1 = forever, 0 = none). The slot is kept meanwhile.
MAX_RETRIES=8
RETRY_BASE_DELAY_S=2
RETRY_MAX_DELAY_S=60
UPSTREAM_CONNECT_TIMEOUT_S=15
# Max silence between upstream bytes before giving up.
UPSTREAM_READ_TIMEOUT_S=600

# --- Security -----------------------------------------------------------------------------

MAX_BODY_MB=20
# Failed-auth attempts per minute per IP before a temporary block.
AUTH_FAIL_LIMIT=10
AUTH_BLOCK_S=300
# Proxies whose X-Forwarded-For is trusted (Docker networks by default).
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.1/32

LOG_LEVEL=INFO
